{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/image.ts": {
      "memory": 1769,
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/payments/sweep",
      "schedule": "0 3 * * *"
    }
  ]
}
